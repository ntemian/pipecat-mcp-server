# ─── Voice loop (voice_loop.py) ──────────────────────────────────────────────
# Required: Anthropic API key (drives the brain). Charges per token.
# Sonnet 4.5 default ≈ $3/Mtok in, $15/Mtok out — ~$5-15 for a 3hr drive.
ANTHROPIC_API_KEY=

# Override the model. For driving: Sonnet 4.5 = balance, Haiku 4.5 = fastest, Opus 4.7 = deepest.
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# WebRTC port (must match Tailscale funnel target).
VOICE_LOOP_PORT=7860

# ─── TTS (used by both voice_loop and the MCP-server agent) ─────────────────
# "kokoro" (free local) or "elevenlabs" (premium, ~$10 / 3hr)
TTS_PROVIDER=elevenlabs

# ElevenLabs (only if TTS_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=
# Default "Rachel". Pick any voice ID from your library.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# eleven_turbo_v2_5 = lowest latency multilingual. eleven_multilingual_v2 = better Greek quality.
ELEVENLABS_MODEL=eleven_turbo_v2_5

# Kokoro (only if TTS_PROVIDER=kokoro). Voices: af_heart, af_bella, am_michael, etc.
KOKORO_VOICE_ID=af_heart
